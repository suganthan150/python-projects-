balance=100000
v=int(input("Enter the looping time:"))
for i in range(0,v):
        print("IOB")
        print("1.Withdraw")
        print("2.deposit")
        print("3.Balance")
        choice=int(input("Enter your choice code:"))
        if(choice==1):
              withdraw=int(input("Enter the withdraw amount:"))
              balance-=withdraw
        elif(choice==2):
              deposit=int(input("Enter the deposit value:"))
              balance+=deposit
        elif(choice==3):
              print("Your balance Amount is:",balance)
        else:
              print("invalid choice")
